{
  "name": "next14-ts-tailwind-eslint-prettier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "run-p -l -c --aggregate-output lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "fix": "run-s fix:prettier fix:eslint",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:prettier": "npm run lint:prettier -- --write",
    "prepare": "husky install"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "20.17.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
